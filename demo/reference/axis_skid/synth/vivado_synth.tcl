# Customer-side sign-off synthesis for axis_skid (run on a licensed Vivado):
#   cd demo/reference/axis_skid/synth && vivado -mode batch -source vivado_synth.tcl [-tclargs <part>]
# Generated by tools/gen_vivado_tcl.py from the block Makefile (TOP/SRCS/CLK_MHZ/PART);
# gives what Yosys cannot: exact primitive counts and timing (WNS) at 300 MHz.
set part xczu28dr-ffvg1517-2-e
if {$argc > 0} { set part [lindex $argv 0] }
read_verilog -sv ../rtl/axis_skid.sv
read_xdc constraints.xdc
synth_design -top axis_skid -part $part -mode out_of_context -retiming
report_utilization    -file utilization.rpt
report_timing_summary -file timing_summary.rpt
puts "DONE: see utilization.rpt (LUT/FF/DSP48E2/BRAM rows) and timing_summary.rpt (WNS >= 0 means 300 MHz met)"
